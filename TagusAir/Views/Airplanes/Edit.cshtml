@model TagusAir.Models.AirplaneViewModel

@{
    ViewData["Title"] = "Edit airplane";
}

<section class="py-7">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-9 col-lg-7">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">

                        <div class="text-center mb-5">
                            <span class="fas fa-plane text-primary" style="font-size: 2.5rem;"></span>
                            <h2 class="fw-bold mt-3 mb-1">Edit airplane</h2>
                            <p class="text-900 mb-0">@Model.Brand @Model.Model</p>
                        </div>

                        <form asp-action="Edit" method="post" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" class="mb-3"></div>

                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="ImageUrl" />

                            <div class="row g-4">

                                <div class="col-sm-6">
                                    <label asp-for="Brand" class="form-label fw-medium"></label>
                                    <input asp-for="Brand" class="form-control form-voyage-control" />
                                    <span asp-validation-for="Brand" class="text-danger"></span>
                                </div>

                                <div class="col-sm-6">
                                    <label asp-for="Model" class="form-label fw-medium"></label>
                                    <input asp-for="Model" class="form-control form-voyage-control" />
                                    <span asp-validation-for="Model" class="text-danger"></span>
                                </div>

                                <div class="col-12">
                                    <div class="bg-light border rounded p-3">
                                        <div class="row">
                                            <div class="col-sm-6">
                                                <span class="text-800 fs--1 d-block">@Html.DisplayNameFor(m => m.EconomySeats)</span>
                                                <span class="fw-bold">@Model.EconomySeats</span>
                                                <input type="hidden" asp-for="EconomySeats" />
                                            </div>
                                            <div class="col-sm-6">
                                                <span class="text-800 fs--1 d-block">@Html.DisplayNameFor(m => m.BusinessSeats)</span>
                                                <span class="fw-bold">@Model.BusinessSeats</span>
                                                <input type="hidden" asp-for="BusinessSeats" />
                                            </div>
                                        </div>

                                        <p class="text-800 fs--1 mb-0 mt-3">
                                            <span class="fas fa-info-circle me-1"></span>
                                            Seat numbers cannot be changed after the airplane is created.
                                        </p>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label asp-for="ImageFile" class="form-label fw-medium"></label>

                                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                    {
                                        <div class="mb-3">
                                            <img src="@Model.ImageUrl" alt="@Model.Brand"
                                                 class="rounded border"
                                                 style="width: 160px; height: 100px; object-fit: cover;" />
                                        </div>
                                    }

                                    <input asp-for="ImageFile" type="file" accept="image/*"
                                           class="form-control form-voyage-control" />
                                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                                </div>

                                <div class="col-12">
                                    <div class="form-check">
                                        <input asp-for="IsActive" class="form-check-input" />
                                        <label asp-for="IsActive" class="form-check-label fw-medium"></label>
                                    </div>
                                </div>

                                <div class="col-12 d-flex gap-2 mt-3">
                                    <button type="submit" class="btn btn-secondary">Save changes</button>
                                    <a asp-action="Index" class="btn btn-outline-dark">Cancel</a>
                                </div>

                            </div>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}