@model IEnumerable<TagusAir.Data.Entities.Airplane>

@{
    ViewData["Title"] = "Airplanes";
}

<section class="py-6">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0">Airplanes</h2>
            <a asp-action="Create" class="btn btn-secondary">
                <span class="fas fa-plus me-2"></span>New airplane
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-7">
                    <span class="fas fa-plane text-primary" style="font-size: 3rem;"></span>
                    <h4 class="fw-bold mt-3 mb-1">No airplanes yet</h4>
                    <p class="text-900 mb-0">Create the first one to start scheduling flights.</p>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4"></th>
                                <th>@Html.DisplayNameFor(model => model.Brand)</th>
                                <th>@Html.DisplayNameFor(model => model.Model)</th>
                                <th>@Html.DisplayNameFor(model => model.EconomySeats)</th>
                                <th>@Html.DisplayNameFor(model => model.BusinessSeats)</th>
                                <th>@Html.DisplayNameFor(model => model.IsActive)</th>
                                <th class="text-end pe-4"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4" style="width: 110px;">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.Brand"
                                                 class="rounded"
                                                 style="width: 90px; height: 60px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <span class="fas fa-plane text-800" style="font-size: 2rem;"></span>
                                        }
                                    </td>
                                    <td class="fw-bold">@item.Brand</td>
                                    <td>@item.Model</td>
                                    <td>@item.EconomySeats</td>
                                    <td>@item.BusinessSeats</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-primary">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-soft-secondary text-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4 text-nowrap">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary">Details</a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

    </div>
</section>