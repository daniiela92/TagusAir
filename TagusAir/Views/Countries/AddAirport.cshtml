@model TagusAir.Models.AirportViewModel

@{
    ViewData["Title"] = "Add Airport";
}

<h2>Add Airport</h2>

<div class="row">
    <div class="col-md-5">
        <form asp-action="AddAirport" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="CountryId" />

            <div class="form-group mb-3">
                <label asp-for="City" class="control-label"></label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IataCode" class="control-label"></label>
                <input asp-for="IataCode" class="form-control" />
                <span asp-validation-for="IataCode" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Add</button>
            <a asp-action="Details" asp-route-id="@Model.CountryId" class="btn btn-secondary">Back</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}