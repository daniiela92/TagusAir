@model TagusAir.Models.AirportViewModel

@{
    ViewData["Title"] = "Edit airport";
}

<section class="py-7">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-9 col-lg-7">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">

                        <div class="text-center mb-5">
                            <span class="fas fa-map-marker-alt text-primary" style="font-size: 2.5rem;"></span>
                            <h2 class="fw-bold mt-3 mb-1">Edit airport</h2>
                            <p class="text-900 mb-0">@Model.Name</p>
                        </div>

                        <form asp-action="EditAirport" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <input type="hidden" asp-for="AirportId" />
                            <input type="hidden" asp-for="CountryId" />

                            <div class="row g-4">

                                <div class="col-12">
                                    <label asp-for="Name" class="form-label fw-medium"></label>
                                    <input asp-for="Name" class="form-control form-voyage-control" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>

                                <div class="col-sm-8">
                                    <label asp-for="City" class="form-label fw-medium"></label>
                                    <input asp-for="City" class="form-control form-voyage-control" />
                                    <span asp-validation-for="City" class="text-danger"></span>
                                </div>

                                <div class="col-sm-4">
                                    <label asp-for="IataCode" class="form-label fw-medium"></label>
                                    <input asp-for="IataCode" class="form-control form-voyage-control"
                                           maxlength="3" style="text-transform: uppercase;" />
                                    <span asp-validation-for="IataCode" class="text-danger"></span>
                                </div>

                                <div class="col-12 d-flex gap-2 mt-3">
                                    <button type="submit" class="btn btn-secondary">Save changes</button>
                                    <a asp-action="Details" asp-route-id="@Model.CountryId"
                                       class="btn btn-outline-dark">Cancel</a>
                                </div>

                            </div>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}