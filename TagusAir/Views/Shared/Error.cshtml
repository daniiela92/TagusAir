@{
    ViewData["Title"] = "Something went wrong";
}

<section class="py-7">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 text-center">

                <span class="fas fa-triangle-exclamation text-primary" style="font-size: 4rem;"></span>

                <h2 class="fw-bold mt-4 mb-3">Something went wrong on our side</h2>

                <p class="text-900 mb-5">
                    Sorry about that. Please try again in a moment.
                </p>

                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Back to home</a>

            </div>
        </div>
    </div>
</section>