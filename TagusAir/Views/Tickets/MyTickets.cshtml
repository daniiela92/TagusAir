@model List<TagusAir.Data.Entities.Ticket>

@{
    ViewData["Title"] = "My Tickets";
}

<h2>My Tickets</h2>

@if (Model.Count == 0)
{
    <p>You haven't bought any tickets yet.</p>
    <a asp-controller="Flights" asp-action="Index" class="btn btn-primary">Browse flights</a>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Flight</th>
                <th>Route</th>
                <th>Departure</th>
                <th>Seat</th>
                <th>Price</th>
                <th>Purchased</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Flight.FlightNumber</td>
                    <td>
                        @item.Flight.DepartureAirport.IataCode
                        &rarr;
                        @item.Flight.ArrivalAirport.IataCode
                    </td>
                    <td>@item.Flight.DepartureTime.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Seat.Code (@item.Seat.Class)</td>
                    <td>@item.Price.ToString("C2")</td>
                    <td>@item.PurchaseDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (item.Flight.DepartureTime < DateTime.Now)
                        {
                            <span class="badge bg-secondary">Past</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Upcoming</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}