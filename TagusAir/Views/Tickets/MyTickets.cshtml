@model List<TagusAir.Data.Entities.Ticket>

@{
    ViewData["Title"] = "My Tickets";
}

<section class="py-6">
    <div class="container">

        <h2 class="fw-bold mb-5">My tickets</h2>

        @if (Model.Count == 0)
        {
            <div class="text-center py-8">
                <i class="fas fa-ticket-alt text-primary" style="font-size: 4rem;"></i>
                <h3 class="mt-4 fw-bold">No tickets yet</h3>
                <p class="text-900">When you book a flight, your tickets will show up here.</p>
                <a asp-controller="Flights" asp-action="Index" class="btn btn-secondary mt-3">Browse flights</a>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body p-4">
                        <div class="row align-items-center g-3">

                            <div class="col-md-4">
                                <div class="d-flex align-items-center">
                                    <div>
                                        <h4 class="fw-bold mb-0">@item.Flight.DepartureAirport.IataCode</h4>
                                        <span class="text-900 fs--1">@item.Flight.DepartureAirport.City</span>
                                    </div>
                                    <i class="fas fa-plane text-primary mx-3"></i>
                                    <div>
                                        <h4 class="fw-bold mb-0">@item.Flight.ArrivalAirport.IataCode</h4>
                                        <span class="text-900 fs--1">@item.Flight.ArrivalAirport.City</span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="text-900">
                                    <i class="fas fa-plane-departure text-800 me-2"></i>
                                    @item.Flight.FlightNumber
                                </div>
                                <div class="text-900">
                                    <i class="fas fa-calendar text-800 me-2"></i>
                                    @item.Flight.DepartureTime.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="text-900">
                                    <i class="fas fa-chair text-800 me-2"></i>
                                    Seat <span class="fw-bold">@item.Seat.Code</span> &middot; @item.Seat.Class
                                </div>
                                <div class="text-900">
                                    <i class="fas fa-tag text-800 me-2"></i>
                                    @item.Price.ToString("C2")
                                </div>
                            </div>

                            <div class="col-md-2 text-md-end">
                                @if (item.Flight.DepartureTime < DateTime.Now)
                                {
                                    <span class="badge bg-soft-secondary text-secondary p-2">Past</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary p-2">Upcoming</span>

                                    <div class="mt-2">
                                        <a asp-action="Cancel" asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm">Cancel</a>
                                    </div>
                                }

                                <div class="text-800 fs--1 mt-2">
                                    Bought @item.PurchaseDate.ToString("dd/MM/yyyy")
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }

    </div>
</section>