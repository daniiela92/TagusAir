@model IEnumerable<TagusAir.Data.Entities.Ticket>

@{
    var isStaff = User.IsInRole("Employee");

    ViewData["Title"] = isStaff ? "Flight history" : "My Tickets";
}

<section class="py-6">
    <div class="container">

        <h2 class="fw-bold mb-5">@(isStaff ? "Flight history" : "My tickets")</h2>

        @if (isStaff)
        {
            <form asp-action="MyTickets" method="get" class="row g-2 mb-4">
                <div class="col-sm-6 col-lg-4">
                    <input type="text" name="search" value="@ViewBag.Search"
                           class="form-control form-voyage-control"
                           placeholder="Search by passenger name" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-secondary">Search</button>
                </div>

                @if (!string.IsNullOrEmpty((string)ViewBag.Search))
                {
                    <div class="col-auto">
                        <a asp-action="MyTickets" class="btn btn-outline-secondary">Clear</a>
                    </div>
                }
            </form>
        }

        @if (!Model.Any())
        {
            <div class="text-center py-8">
                <i class="fas fa-ticket-alt text-primary" style="font-size: 4rem;"></i>
                <h3 class="mt-4 fw-bold">@(isStaff ? "No tickets found" : "No tickets yet")</h3>

                @if (!isStaff)
                {
                    <p class="text-900">When you book a flight, your tickets will show up here.</p>
                    <a asp-controller="Flights" asp-action="Index" class="btn btn-secondary mt-3">Browse flights</a>
                }
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                var isUpcoming = item.Flight.DepartureTime >= DateTime.Now;
                var flightCancelled = !item.Flight.IsActive;
                var canCancel = isUpcoming && !isStaff && !item.IsCanceled && !flightCancelled;
                var canChange = isUpcoming && !item.IsCanceled && !flightCancelled;

                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body p-4">
                        <div class="row align-items-center g-3">

                            <div class="col-md-4">
                                <div class="d-flex align-items-center">
                                    <div>
                                        <h4 class="fw-bold mb-0">@item.Flight.DepartureAirport.IataCode</h4>
                                        <span class="text-900 fs--1">@item.Flight.DepartureAirport.City</span>
                                    </div>
                                    <i class="fas fa-plane text-primary mx-3"></i>
                                    <div>
                                        <h4 class="fw-bold mb-0">@item.Flight.ArrivalAirport.IataCode</h4>
                                        <span class="text-900 fs--1">@item.Flight.ArrivalAirport.City</span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="text-900">
                                    <i class="fas fa-plane-departure text-800 me-2"></i>
                                    @item.Flight.FlightNumber
                                </div>
                                <div class="text-900">
                                    <i class="fas fa-calendar text-800 me-2"></i>
                                    @item.Flight.DepartureTime.ToString("dd/MM/yyyy HH:mm")
                                </div>

                                @if (isStaff && item.User != null)
                                {
                                    <div class="text-900">
                                        <i class="fas fa-user text-800 me-2"></i>
                                        @item.User.FirstName @item.User.LastName
                                    </div>
                                }
                            </div>

                            <div class="col-md-3">
                                <div class="text-900">
                                    <i class="fas fa-chair text-800 me-2"></i>
                                    Seat <span class="fw-bold">@item.Seat.Code</span> &middot; @item.Seat.Class
                                </div>
                                <div class="text-900">
                                    <i class="fas fa-tag text-800 me-2"></i>
                                    @item.Price.ToString("C2")
                                </div>
                            </div>

                            <div class="col-md-2 text-md-end">
                                @if (item.IsCanceled)
                                {
                                    <span class="badge bg-danger p-2">Cancelled</span>
                                }
                                else if (flightCancelled)
                                {
                                    <span class="badge bg-danger p-2">Flight cancelled</span>
                                }
                                else if (isUpcoming)
                                {
                                    <span class="badge bg-primary p-2">Upcoming</span>
                                }
                                else
                                {
                                    <span class="badge bg-soft-secondary text-secondary p-2">Past</span>
                                }

                                <div class="d-flex flex-wrap gap-2 justify-content-md-end mt-2">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-outline-dark btn-sm">Details</a>

                                    @if (canCancel)
                                    {
                                        <a asp-action="Cancel" asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm">Cancel</a>
                                    }
                                    @if (canChange)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-outline-primary btn-sm">Change seat</a>
                                    }
                                </div>

                                <div class="text-800 fs--1 mt-2">
                                    Bought @item.PurchaseDate.ToString("dd/MM/yyyy")
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }

    </div>
</section>