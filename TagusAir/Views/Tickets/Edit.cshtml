@model TagusAir.Models.EditTicketViewModel

@{
    ViewData["Title"] = "Change seat";
}

<section class="py-7">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">

                        <h2 class="fw-bold mb-1">Change your seat</h2>
                        <p class="text-900 mb-4">
                            You can move to any free seat in the same class.
                        </p>

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="bg-light border rounded p-3 mb-4">

                            <div class="d-flex justify-content-between py-1">
                                <span class="text-800">Flight</span>
                                <span class="fw-bold">@Model.Flight.FlightNumber</span>
                            </div>

                            <div class="d-flex justify-content-between py-1">
                                <span class="text-800">Route</span>
                                <span class="fw-bold">
                                    @Model.Flight.DepartureAirport.IataCode &rarr; @Model.Flight.ArrivalAirport.IataCode
                                </span>
                            </div>

                            <div class="d-flex justify-content-between py-1">
                                <span class="text-800">Departure</span>
                                <span class="fw-bold">@Model.Flight.DepartureTime.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>

                            <div class="d-flex justify-content-between py-1">
                                <span class="text-800">Current seat</span>
                                <span class="fw-bold">@Model.CurrentSeat</span>
                            </div>

                        </div>

                        <form asp-action="Edit" method="post">
                            <input type="hidden" asp-for="Id" />

                            <div class="mb-4">
                                <label asp-for="SeatId" class="form-label fw-medium"></label>
                                <select asp-for="SeatId" asp-items="Model.Seats"
                                        class="form-select form-voyage-control"></select>
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-dark">Back</a>
                                <button type="submit" class="btn btn-secondary">Change seat</button>
                            </div>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>