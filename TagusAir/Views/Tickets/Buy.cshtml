@model TagusAir.Models.BuyTicketViewModel

@{
    ViewData["Title"] = "Buy ticket";
}

<section class="py-6">
    <div class="container">

        <h2 class="fw-bold mb-5">Complete your booking</h2>

        <div class="row g-4">

            <div class="col-lg-7">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">

                        <form asp-action="Buy" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                            <input type="hidden" asp-for="FlightId" />

                            @if (!User.Identity.IsAuthenticated)
                            {
                                <h5 class="fw-bold mb-1">Your details</h5>
                                <p class="text-900 mb-4">
                                    We'll create an account for you so you can manage this booking later.
                                </p>

                                <div class="row g-3 mb-4">
                                    <div class="col-sm-6">
                                        <label asp-for="FirstName" class="form-label fw-medium"></label>
                                        <input asp-for="FirstName" class="form-control form-voyage-control" />
                                        <span asp-validation-for="FirstName" class="text-danger"></span>
                                    </div>

                                    <div class="col-sm-6">
                                        <label asp-for="LastName" class="form-label fw-medium"></label>
                                        <input asp-for="LastName" class="form-control form-voyage-control" />
                                        <span asp-validation-for="LastName" class="text-danger"></span>
                                    </div>

                                    <div class="col-12">
                                        <label asp-for="Email" class="form-label fw-medium"></label>
                                        <input asp-for="Email" class="form-control form-voyage-control" placeholder="you@@example.com" />
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>
                                </div>

                                <hr class="my-4" />
                            }

                            <h5 class="fw-bold mb-1">Choose your seat</h5>
                            <p class="text-900 mb-4">
                                Seats starting with E are economy, seats starting with B are business.
                            </p>

                            <div class="mb-4">
                                <label asp-for="SeatId" class="form-label fw-medium">Seat</label>
                                <select asp-for="SeatId" asp-items="Model.Seats" class="form-select form-voyage-select"></select>
                                <span asp-validation-for="SeatId" class="text-danger"></span>
                            </div>

                            <div class="d-grid gap-2 d-sm-flex">
                                <button type="submit" class="btn btn-secondary">
                                    <i class="fas fa-check me-2"></i>Confirm purchase
                                </button>
                                <a asp-controller="Flights" asp-action="Index" class="btn btn-voyage-outline">
                                    Back to flights
                                </a>
                            </div>
                        </form>

                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm bg-soft-primary">
                    <div class="card-body p-5">

                        <span class="badge bg-primary mb-3">@Model.Flight.FlightNumber</span>

                        <div class="d-flex align-items-center mb-4">
                            <div>
                                <h4 class="fw-bold mb-0">@Model.Flight.DepartureAirport.IataCode</h4>
                                <span class="text-900">@Model.Flight.DepartureAirport.City</span>
                            </div>
                            <i class="fas fa-plane text-primary mx-4"></i>
                            <div>
                                <h4 class="fw-bold mb-0">@Model.Flight.ArrivalAirport.IataCode</h4>
                                <span class="text-900">@Model.Flight.ArrivalAirport.City</span>
                            </div>
                        </div>

                        <div class="mb-2 text-900">
                            <i class="fas fa-calendar text-800 me-2"></i>
                            @Model.Flight.DepartureTime.ToString("dd/MM/yyyy")
                        </div>
                        <div class="mb-4 text-900">
                            <i class="fas fa-clock text-800 me-2"></i>
                            @Model.Flight.DepartureTime.ToString("HH:mm") &ndash; @Model.Flight.ArrivalTime.ToString("HH:mm")
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-900">Economy</span>
                            <span class="fw-bold">@Model.Flight.BasePrice.ToString("C2")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-900">Business</span>
                            <span class="fw-bold">@Model.Flight.BusinessPrice.ToString("C2")</span>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}