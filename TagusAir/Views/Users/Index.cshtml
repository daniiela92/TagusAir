@model TagusAir.Models.UserListViewModel

@{
    ViewData["Title"] = "Users";
}

<section class="py-6">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0">Users</h2>
            <a asp-action="Create" class="btn btn-secondary">
                <span class="fas fa-plus me-2"></span>New user
            </a>
        </div>

        <h5 class="fw-bold mb-3">Employees</h5>

        <div class="card border-0 shadow-sm mb-5">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4"></th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone Number</th>
                            <th>Status</th>
                            <th class="text-end pe-4"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Employees.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-900 py-4">No employees yet.</td>
                            </tr>
                        }

                        @foreach (var item in Model.Employees)
                        {
                            <tr>
                                <td class="ps-4" style="width: 64px;">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" class="rounded-circle"
                                             style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span class="fas fa-user-circle text-800" style="font-size: 40px;"></span>
                                    }
                                </td>
                                <td class="fw-bold">@item.FullName</td>
                                <td>@item.Email</td>
                                <td>@item.PhoneNumber</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-primary">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-soft-secondary text-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                    @if (item.IsActive)
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">Delete</a>
                                    }
                                    else
                                    {
                                        <form asp-action="Activate" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-dark">Activate</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <h5 class="fw-bold mb-3">Customers</h5>

        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4"></th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone Number</th>
                            <th>Passport</th>
                            <th>Status</th>
                            <th class="text-end pe-4"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Customers.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-900 py-4">No customers yet.</td>
                            </tr>
                        }

                        @foreach (var item in Model.Customers)
                        {
                            <tr>
                                <td class="ps-4" style="width: 64px;">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" class="rounded-circle"
                                             style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span class="fas fa-user-circle text-800" style="font-size: 40px;"></span>
                                    }
                                </td>
                                <td class="fw-bold">@item.FullName</td>
                                <td>@item.Email</td>
                                <td>@item.PhoneNumber</td>
                                <td>@item.Passport</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-primary">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-soft-secondary text-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                    @if (item.IsActive)
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">Delete</a>
                                    }
                                    else
                                    {
                                        <form asp-action="Activate" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-dark">Activate</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>