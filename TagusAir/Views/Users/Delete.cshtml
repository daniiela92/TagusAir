@model TagusAir.Models.EditUserViewModel

@{
    ViewData["Title"] = "Delete User";
}

<h2>Delete User</h2>

<h4 class="text-danger">Are you sure you want to delete this user?</h4>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<hr />

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FirstName)</dt>
    <dd class="col-sm-9">@Model.FirstName</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.LastName)</dt>
    <dd class="col-sm-9">@Model.LastName</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PhoneNumber)</dt>
    <dd class="col-sm-9">@Model.PhoneNumber</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Passport)</dt>
    <dd class="col-sm-9">@Model.Passport</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>