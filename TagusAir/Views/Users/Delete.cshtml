@model TagusAir.Models.EditUserViewModel

@{
    ViewData["Title"] = "Delete user";
}

<section class="py-7">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">

                        <div class="text-center mb-4">
                            <span class="fas fa-exclamation-triangle text-danger" style="font-size: 2.5rem;"></span>
                            <h2 class="fw-bold mt-3 mb-1">Delete this user?</h2>
                            <p class="text-900 mb-0">
                                The user will be deactivated and will no longer be able to log in.
                                You can reactivate the account later.
                            </p>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="text-center mb-3"></div>

                        <div class="text-center mb-4">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl" class="rounded-circle"
                                     style="width: 80px; height: 80px; object-fit: cover;" />
                            }
                            else
                            {
                                <span class="fas fa-user-circle text-800" style="font-size: 80px;"></span>
                            }
                        </div>

                        <div class="bg-light border rounded p-3 mb-4">

                            <div class="d-flex justify-content-between py-1">
                                <span class="text-800">Name</span>
                                <span class="fw-bold">@Model.FirstName @Model.LastName</span>
                            </div>

                            <div class="d-flex justify-content-between py-1">
                                <span class="text-800">@Html.DisplayNameFor(model => model.Email)</span>
                                <span class="fw-bold">@Model.Email</span>
                            </div>

                            <div class="d-flex justify-content-between py-1">
                                <span class="text-800">@Html.DisplayNameFor(model => model.PhoneNumber)</span>
                                <span class="fw-bold">@Model.PhoneNumber</span>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Passport))
                            {
                                <div class="d-flex justify-content-between py-1">
                                    <span class="text-800">@Html.DisplayNameFor(model => model.Passport)</span>
                                    <span class="fw-bold">@Model.Passport</span>
                                </div>
                            }

                        </div>

                        <form asp-action="Delete" method="post">
                            <input type="hidden" asp-for="Id" />

                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Index" class="btn btn-outline-dark">Cancel</a>
                                <button type="submit" class="btn btn-danger">Delete user</button>
                            </div>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>