@model TagusAir.Models.EditUserViewModel

@{
    ViewData["Title"] = "Edit user";
}

<section class="py-7">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-9 col-lg-7">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">

                        <div class="text-center mb-5">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl" class="rounded-circle"
                                     style="width: 80px; height: 80px; object-fit: cover;" />
                            }
                            else
                            {
                                <span class="fas fa-user-circle text-primary" style="font-size: 80px;"></span>
                            }

                            <h2 class="fw-bold mt-3 mb-1">@Model.FirstName @Model.LastName</h2>
                            <p class="text-900 mb-0">@Model.Email</p>
                        </div>

                        <form asp-action="Edit" method="post" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" class="mb-3"></div>

                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="ImageUrl" />
                            <input type="hidden" asp-for="Email" />
                            <input type="hidden" asp-for="IsCustomer" />

                            <div class="row g-4">

                                <div class="col-sm-6">
                                    <label asp-for="FirstName" class="form-label fw-medium"></label>
                                    <input asp-for="FirstName" class="form-control form-voyage-control" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>

                                <div class="col-sm-6">
                                    <label asp-for="LastName" class="form-label fw-medium"></label>
                                    <input asp-for="LastName" class="form-control form-voyage-control" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>

                                <div class="col-sm-6">
                                    <label asp-for="PhoneNumber" class="form-label fw-medium"></label>
                                    <input asp-for="PhoneNumber" class="form-control form-voyage-control" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>

                                @if (Model.IsCustomer)
                                {
                                    <div class="col-sm-6">
                                        <label asp-for="Passport" class="form-label fw-medium"></label>
                                        <input asp-for="Passport" class="form-control form-voyage-control" />
                                        <span asp-validation-for="Passport" class="text-danger"></span>
                                    </div>
                                }

                                <div class="col-12">
                                    <label asp-for="ImageFile" class="form-label fw-medium"></label>
                                    <input asp-for="ImageFile" type="file" accept="image/*"
                                           class="form-control form-voyage-control" />
                                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                                </div>

                                <div class="col-12 d-flex gap-2 mt-3">
                                    <button type="submit" class="btn btn-secondary">Save changes</button>
                                    <a asp-action="Index" class="btn btn-outline-dark">Cancel</a>
                                </div>

                            </div>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}