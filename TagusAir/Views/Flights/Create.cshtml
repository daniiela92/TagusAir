@model TagusAir.Models.FlightViewModel

@{
    ViewData["Title"] = "New flight";
}

<section class="py-7">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-10 col-lg-8">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">

                        <div class="text-center mb-5">
                            <span class="fas fa-plane-departure text-primary" style="font-size: 2.5rem;"></span>
                            <h2 class="fw-bold mt-3 mb-1">New flight</h2>
                            <p class="text-900 mb-0">Schedule a flight and put it on sale</p>
                        </div>

                        <form asp-action="Create" method="post">
                            <div asp-validation-summary="ModelOnly" class="mb-3"></div>

                            <div class="row g-4">

                                <div class="col-sm-5">
                                    <label asp-for="FlightNumber" class="form-label fw-medium"></label>
                                    <input asp-for="FlightNumber" class="form-control form-voyage-control" />
                                    <span asp-validation-for="FlightNumber" class="text-danger"></span>
                                </div>

                                <div class="col-sm-7">
                                    <label asp-for="AirplaneId" class="form-label fw-medium"></label>
                                    <select asp-for="AirplaneId" asp-items="Model.Airplanes"
                                            class="form-select form-voyage-control"></select>
                                    <span asp-validation-for="AirplaneId" class="text-danger"></span>
                                </div>

                                <div class="col-12">
                                    <div class="bg-light border rounded p-3">

                                        <p class="fw-medium mb-3">
                                            <span class="fas fa-plane-departure text-primary me-2"></span>Departure
                                        </p>

                                        <div class="row g-3">
                                            <div class="col-sm-6">
                                                <label asp-for="DepartureCountryId" class="form-label fw-medium"></label>
                                                <select asp-for="DepartureCountryId" asp-items="Model.Countries"
                                                        class="form-select form-voyage-control"></select>
                                            </div>

                                            <div class="col-sm-6">
                                                <label asp-for="DepartureAirportId" class="form-label fw-medium"></label>
                                                <select asp-for="DepartureAirportId" asp-items="Model.DepartureAirports"
                                                        class="form-select form-voyage-control"></select>
                                                <span asp-validation-for="DepartureAirportId" class="text-danger"></span>
                                            </div>

                                            <div class="col-12">
                                                <label asp-for="DepartureTime" class="form-label fw-medium"></label>
                                                <input asp-for="DepartureTime" class="form-control form-voyage-control" />
                                                <span asp-validation-for="DepartureTime" class="text-danger"></span>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="bg-light border rounded p-3">

                                        <p class="fw-medium mb-3">
                                            <span class="fas fa-plane-arrival text-primary me-2"></span>Arrival
                                        </p>

                                        <div class="row g-3">
                                            <div class="col-sm-6">
                                                <label asp-for="ArrivalCountryId" class="form-label fw-medium"></label>
                                                <select asp-for="ArrivalCountryId" asp-items="Model.Countries"
                                                        class="form-select form-voyage-control"></select>
                                            </div>

                                            <div class="col-sm-6">
                                                <label asp-for="ArrivalAirportId" class="form-label fw-medium"></label>
                                                <select asp-for="ArrivalAirportId" asp-items="Model.ArrivalAirports"
                                                        class="form-select form-voyage-control"></select>
                                                <span asp-validation-for="ArrivalAirportId" class="text-danger"></span>
                                            </div>

                                            <div class="col-12">
                                                <label asp-for="ArrivalTime" class="form-label fw-medium"></label>
                                                <input asp-for="ArrivalTime" class="form-control form-voyage-control" />
                                                <span asp-validation-for="ArrivalTime" class="text-danger"></span>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                                <div class="col-sm-5">
                                    <label asp-for="BasePrice" class="form-label fw-medium"></label>
                                    <input asp-for="BasePrice" class="form-control form-voyage-control" />
                                    <span asp-validation-for="BasePrice" class="text-danger"></span>
                                </div>

                                <div class="col-12 d-flex gap-2 mt-3">
                                    <button type="submit" class="btn btn-secondary">Create flight</button>
                                    <a asp-action="Index" class="btn btn-outline-dark">Cancel</a>
                                </div>

                            </div>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @{
        await Html.RenderPartialAsync("_ValidationCurrencyPartial");
    }

    <script type="text/javascript">
        $(document).ready(function () {

            function loadAirports(countrySelect, airportSelect) {
                $(airportSelect).empty();
                $.ajax({
                    url: '@Url.Action("GetAirportsAsync", "Flights")',
                    type: 'POST',
                    dataType: 'json',
                    data: { countryId: $(countrySelect).val() },
                    success: function (airports) {
                        $(airportSelect).append('<option value="0">(Select an airport...)</option>');
                        $.each(airports, function (i, airport) {
                            $(airportSelect).append('<option value="'
                                + airport.id + '">'
                                + airport.city + ' - ' + airport.name + ' (' + airport.iataCode + ')</option>');
                        });
                    },
                    error: function (ex) {
                        alert('Failed to retrieve airports.' + ex);
                    }
                });
                return false;
            }

            $("#DepartureCountryId").change(function () {
                loadAirports("#DepartureCountryId", "#DepartureAirportId");
            });

            $("#ArrivalCountryId").change(function () {
                loadAirports("#ArrivalCountryId", "#ArrivalAirportId");
            });

        });
    </script>
}