@model TagusAir.Data.Entities.Flight

@{
    ViewData["Title"] = "Flight details";
}

<section class="py-6">
    <div class="container">

        <div class="row g-4">

            <div class="col-lg-8">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-5">

                        <span class="badge bg-soft-primary text-primary mb-4">@Model.FlightNumber</span>

                        <div class="row align-items-center g-3 mb-4">

                            <div class="col-4">
                                @if (!string.IsNullOrEmpty(Model.DepartureAirport.Country.FlagImageUrl))
                                {
                                    <img src="@Model.DepartureAirport.Country.FlagImageUrl"
                                         class="rounded border mb-2"
                                         style="width: 28px; height: 20px; object-fit: cover;" />
                                }
                                <h1 class="fw-bolder mb-0">@Model.DepartureAirport.IataCode</h1>
                                <div class="text-900">@Model.DepartureAirport.City</div>
                                <div class="text-800 fs--1">@Model.DepartureAirport.Name</div>
                            </div>

                            <div class="col-4 text-center">
                                <div class="text-800 fs--1 mb-1">
                                    @($"{Model.Duration.Hours}h {Model.Duration.Minutes:00}m")
                                </div>
                                <div class="d-flex align-items-center">
                                    <div class="flex-grow-1 border-top"></div>
                                    <i class="fas fa-plane text-primary mx-2"></i>
                                    <div class="flex-grow-1 border-top"></div>
                                </div>
                                <div class="text-800 fs--1 mt-1">Direct</div>
                            </div>

                            <div class="col-4 text-end">
                                @if (!string.IsNullOrEmpty(Model.ArrivalAirport.Country.FlagImageUrl))
                                {
                                    <img src="@Model.ArrivalAirport.Country.FlagImageUrl"
                                         class="rounded border mb-2"
                                         style="width: 28px; height: 20px; object-fit: cover;" />
                                }
                                <h1 class="fw-bolder mb-0">@Model.ArrivalAirport.IataCode</h1>
                                <div class="text-900">@Model.ArrivalAirport.City</div>
                                <div class="text-800 fs--1">@Model.ArrivalAirport.Name</div>
                            </div>

                        </div>

                        <div class="row g-3 mb-4">

                            <div class="col-6">
                                <div class="bg-light border rounded p-3">
                                    <div class="text-800 fs--1 mb-1">Departure</div>
                                    <h4 class="fw-bold mb-0">@Model.DepartureTime.ToString("HH:mm")</h4>
                                    <div class="text-900">@Model.DepartureTime.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="bg-light border rounded p-3">
                                    <div class="text-800 fs--1 mb-1">Arrival</div>
                                    <h4 class="fw-bold mb-0">@Model.ArrivalTime.ToString("HH:mm")</h4>
                                    <div class="text-900">@Model.ArrivalTime.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>

                        </div>

                        <hr class="my-4" />

                        <div class="d-flex align-items-center">
                            @if (!string.IsNullOrEmpty(Model.Airplane.ImageUrl))
                            {
                                <img src="@Model.Airplane.ImageUrl"
                                     class="rounded border me-3"
                                     style="width: 80px; height: 54px; object-fit: cover;"
                                     alt="@Model.Airplane.Brand @Model.Airplane.Model"
                                     onerror="this.style.display='none'" />
                            }
                            <div>
                                <div class="text-800 fs--1">Aircraft</div>
                                <div class="fw-bold">@Model.Airplane.Brand @Model.Airplane.Model</div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm bg-soft-primary h-100">
                    <div class="card-body p-4 d-flex flex-column">

                        <h5 class="fw-bold mb-4">Fares</h5>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <div class="fw-bold">Economy</div>
                                <div class="text-800 fs--1">Standard seat</div>
                            </div>
                            <span class="fw-bolder fs-5">@Model.BasePrice.ToString("C2")</span>
                        </div>

                        @if (Model.Airplane.BusinessSeats > 0)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div>
                                    <div class="fw-bold">Business</div>
                                    <div class="text-800 fs--1">Extra space and service</div>
                                </div>
                                <span class="fw-bolder fs-5">@Model.BusinessPrice.ToString("C2")</span>
                            </div>
                        }
                        else
                        {
                            <div class="mb-4"></div>
                        }

                        <div class="d-grid gap-2 mt-auto">
                            <a asp-controller="Tickets" asp-action="Buy" asp-route-id="@Model.Id"
                               class="btn btn-secondary">Buy this flight</a>
                            <a asp-action="Index" class="btn btn-outline-dark">Back to flights</a>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>