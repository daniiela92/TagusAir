@model TagusAir.Data.Entities.Flight

@{
    ViewData["Title"] = "Flight details";
}

<section class="py-6">
    <div class="container">

        <div class="row g-4">

            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">

                        <span class="badge bg-soft-primary text-primary mb-3">@Model.FlightNumber</span>

                        <div class="d-flex align-items-center flex-wrap mb-5">
                            <div class="me-4">
                                @if (!string.IsNullOrEmpty(Model.DepartureAirport.Country.FlagImageUrl))
                                {
                                    <img src="@Model.DepartureAirport.Country.FlagImageUrl" style="width: 28px;" class="mb-2" />
                                }
                                <h3 class="fw-bold mb-0">@Model.DepartureAirport.IataCode</h3>
                                <span class="text-900">@Model.DepartureAirport.City</span>
                                <div class="text-800 fs--1">@Model.DepartureAirport.Name</div>
                            </div>

                            <i class="fas fa-plane text-primary fs-3 mx-4"></i>

                            <div>
                                @if (!string.IsNullOrEmpty(Model.ArrivalAirport.Country.FlagImageUrl))
                                {
                                    <img src="@Model.ArrivalAirport.Country.FlagImageUrl" style="width: 28px;" class="mb-2" />
                                }
                                <h3 class="fw-bold mb-0">@Model.ArrivalAirport.IataCode</h3>
                                <span class="text-900">@Model.ArrivalAirport.City</span>
                                <div class="text-800 fs--1">@Model.ArrivalAirport.Name</div>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-sm-4">
                                <div class="text-800 fs--1 mb-1">Departure</div>
                                <div class="fw-bold">@Model.DepartureTime.ToString("dd/MM/yyyy")</div>
                                <div class="fw-bold">@Model.DepartureTime.ToString("HH:mm")</div>
                            </div>

                            <div class="col-sm-4">
                                <div class="text-800 fs--1 mb-1">Arrival</div>
                                <div class="fw-bold">@Model.ArrivalTime.ToString("dd/MM/yyyy")</div>
                                <div class="fw-bold">@Model.ArrivalTime.ToString("HH:mm")</div>
                            </div>

                            <div class="col-sm-4">
                                <div class="text-800 fs--1 mb-1">Duration</div>
                                <div class="fw-bold">@Model.Duration.Hours h @Model.Duration.Minutes min</div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm mb-4">
                    @if (!string.IsNullOrEmpty(Model.Airplane.ImageUrl))
                    {
                        <img src="@Model.Airplane.ImageUrl" class="card-img-top" alt="@Model.Airplane.Brand @Model.Airplane.Model" />
                    }
                    <div class="card-body p-4">
                        <div class="text-800 fs--1 mb-1">Aircraft</div>
                        <h5 class="fw-bold mb-0">@Model.Airplane.Brand @Model.Airplane.Model</h5>
                    </div>
                </div>

                <div class="card border-0 shadow-sm bg-soft-primary">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-900">Economy</span>
                            <span class="fw-bold">@Model.BasePrice.ToString("C2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="text-900">Business</span>
                            <span class="fw-bold">@Model.BusinessPrice.ToString("C2")</span>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-controller="Tickets" asp-action="Buy" asp-route-id="@Model.Id" class="btn btn-secondary">
                                Buy this flight
                            </a>
                            <a asp-action="Index" class="btn btn-voyage-outline">Back to flights</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>