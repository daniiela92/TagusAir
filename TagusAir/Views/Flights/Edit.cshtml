@model TagusAir.Models.FlightViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>FlightViewModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group">
                <label asp-for="FlightNumber" class="control-label"></label>
                <input asp-for="FlightNumber" class="form-control" />
                <span asp-validation-for="FlightNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DepartureTime" class="control-label"></label>
                <input asp-for="DepartureTime" class="form-control" />
                <span asp-validation-for="DepartureTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ArrivalTime" class="control-label"></label>
                <input asp-for="ArrivalTime" class="form-control" />
                <span asp-validation-for="ArrivalTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DepartureCountryId" class="control-label"></label>
                <select asp-for="DepartureCountryId" asp-items="Model.Countries" class="form-control"></select>
            </div>

            <div class="form-group">
                <label asp-for="DepartureAirportId" class="control-label"></label>
                <select asp-for="DepartureAirportId" asp-items="Model.DepartureAirports" class="form-control"></select>
                <span asp-validation-for="DepartureAirportId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ArrivalCountryId" class="control-label"></label>
                <select asp-for="ArrivalCountryId" asp-items="Model.Countries" class="form-control"></select>
            </div>

            <div class="form-group">
                <label asp-for="ArrivalAirportId" class="control-label"></label>
                <select asp-for="ArrivalAirportId" asp-items="Model.ArrivalAirports" class="form-control"></select>
                <span asp-validation-for="ArrivalAirportId" class="text-danger"></span>
            </div>
          
            <div class="form-group">
                <label asp-for="AirplaneId" class="control-label"></label>
                <select asp-for="AirplaneId" asp-items="Model.Airplanes" class="form-control"></select>
                <span asp-validation-for="AirplaneId" class="text-danger"></span>
            </div>
       
            <div class="form-group">
                <label asp-for="BasePrice" class="control-label"></label>
                <input asp-for="BasePrice" class="form-control" />
                <span asp-validation-for="BasePrice" class="text-danger"></span>
            </div>
       
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    @{
        await Html.RenderPartialAsync("_ValidationCurrencyPartial");
    }


    <script type="text/javascript">
        $(document).ready(function () {

            function loadAirports(countrySelect, airportSelect) {
                $(airportSelect).empty();
                $.ajax({
                    url: '@Url.Action("GetAirportsAsync", "Flights")',
                    type: 'POST',
                    dataType: 'json',
                    data: { countryId: $(countrySelect).val() },
                    success: function (airports) {
                        $(airportSelect).append('<option value="0">(Select an airport...)</option>');
                        $.each(airports, function (i, airport) {
                            $(airportSelect).append('<option value="'
                                + airport.id + '">'
                                + airport.city + ' - ' + airport.name + ' (' + airport.iataCode + ')</option>');
                        });
                    },
                    error: function (ex) {
                        alert('Failed to retrieve airports.' + ex);
                    }
                });
                return false;
            }

            $("#DepartureCountryId").change(function () {
                loadAirports("#DepartureCountryId", "#DepartureAirportId");
            });

            $("#ArrivalCountryId").change(function () {
                loadAirports("#ArrivalCountryId", "#ArrivalAirportId");
            });

        });
    </script>
}
