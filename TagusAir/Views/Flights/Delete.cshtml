@model TagusAir.Data.Entities.Flight

@{
    ViewData["Title"] = "Delete flight";
}

<section class="py-7">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">

                        <div class="text-center mb-4">
                            <span class="fas fa-exclamation-triangle text-danger" style="font-size: 2.5rem;"></span>
                            <h2 class="fw-bold mt-3 mb-1">Delete this flight?</h2>
                            <p class="text-900 mb-0">This action cannot be undone.</p>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="text-center mb-3"></div>

                        <div class="bg-light border rounded p-3 mb-4">

                            <div class="d-flex justify-content-between py-1">
                                <span class="text-800">Flight</span>
                                <span class="badge bg-soft-primary text-primary">@Model.FlightNumber</span>
                            </div>

                            <div class="d-flex justify-content-between py-1">
                                <span class="text-800">Route</span>
                                <span class="fw-bold text-end">
                                    @Model.DepartureAirport.City (@Model.DepartureAirport.IataCode)
                                    &rarr;
                                    @Model.ArrivalAirport.City (@Model.ArrivalAirport.IataCode)
                                </span>
                            </div>

                            <div class="d-flex justify-content-between py-1">
                                <span class="text-800">Departure</span>
                                <span class="fw-bold">@Model.DepartureTime.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>

                            <div class="d-flex justify-content-between py-1">
                                <span class="text-800">Arrival</span>
                                <span class="fw-bold">@Model.ArrivalTime.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>

                        </div>

                        <form asp-action="Delete" method="post">
                            <input type="hidden" asp-for="Id" />

                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Index" class="btn btn-outline-dark">Cancel</a>
                                <button type="submit" class="btn btn-danger">Delete flight</button>
                            </div>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>