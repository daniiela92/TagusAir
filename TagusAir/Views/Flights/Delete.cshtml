@model TagusAir.Data.Entities.Flight

@{
    ViewData["Title"] = "Delete Flight";
}

<h2>Delete Flight</h2>

<h4>Are you sure you want to delete this flight?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-3">Flight</dt>
    <dd class="col-sm-9">@Model.FlightNumber</dd>

    <dt class="col-sm-3">Route</dt>
    <dd class="col-sm-9">
        @Model.DepartureAirport.City (@Model.DepartureAirport.IataCode)
        &rarr;
        @Model.ArrivalAirport.City (@Model.ArrivalAirport.IataCode)
    </dd>

    <dt class="col-sm-3">Departure</dt>
    <dd class="col-sm-9">@Model.DepartureTime.ToString("dd/MM/yyyy HH:mm")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>