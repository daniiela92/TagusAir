@model TagusAir.Models.RecoverPasswordViewModel

@{
    ViewData["Title"] = "Recover Password";
}

<section class="py-7">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">

                        <div class="text-center mb-5">
                            <span class="fas fa-key text-primary" style="font-size: 2.5rem;"></span>
                            <h2 class="fw-bold mt-3 mb-1">Forgot your password?</h2>
                            <p class="text-900 mb-0">
                                Tell us your email and we will send you a link to set a new one.
                            </p>
                        </div>

                        @if (!string.IsNullOrEmpty((string)ViewBag.Message))
                        {
                            <div class="alert alert-success" role="alert">
                                @ViewBag.Message
                            </div>
                        }

                        <form asp-action="RecoverPassword" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-4">
                                <label asp-for="Email" class="form-label fw-medium">Email</label>
                                <input asp-for="Email" class="form-control form-voyage-control" placeholder="you@@example.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="d-grid mb-4">
                                <button type="submit" class="btn btn-secondary">Send me a link</button>
                            </div>

                            <div class="text-center">
                                <a class="text-900" asp-action="Login">Back to sign in</a>
                            </div>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}