@model TagusAir.Models.LoginViewModel

@{
    ViewData["Title"] = "Sign in";
}

<section class="py-7">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">

                        <div class="text-center mb-5">
                            <span class="fas fa-plane text-primary" style="font-size: 2.5rem;"></span>
                            <h2 class="fw-bold mt-3 mb-1">Welcome back</h2>
                            <p class="text-900 mb-0">Sign in to manage your bookings</p>
                        </div>

                        <form asp-action="Login" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-4">
                                <label asp-for="Username" class="form-label fw-medium">Email</label>
                                <input asp-for="Username" class="form-control form-voyage-control" placeholder="you@@example.com" />
                                <span asp-validation-for="Username" class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Password" class="form-label fw-medium"></label>
                                <input asp-for="Password" type="password" class="form-control form-voyage-control" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="form-check mb-4">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label">Remember me</label>
                            </div>

                            <div class="d-grid mb-4">
                                <button type="submit" class="btn btn-secondary">Sign in</button>
                            </div>

                            <div class="text-center">
                                <a class="text-900" asp-action="RecoverPassword">Forgot your password?</a>
                            </div>
                        </form>

                    </div>
                </div>

                <p class="text-center mt-4 text-900">
                    Don't have an account?
                    <a class="fw-bold" asp-action="Register">Create one</a>
                </p>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}