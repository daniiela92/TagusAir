@{
    ViewData["Title"] = "Close account";
}

<section class="py-7">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">

                        <div class="text-center mb-4">
                            <span class="fas fa-exclamation-triangle text-danger" style="font-size: 2.5rem;"></span>
                            <h2 class="fw-bold mt-3 mb-1">Close your account?</h2>
                            <p class="text-900 mb-0">
                                You will be signed out and will no longer be able to log in.
                                Your tickets are not cancelled — contact us if you need a refund.
                            </p>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>

                        <form asp-action="CloseAccount" method="post">
                            @Html.AntiForgeryToken()

                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="ChangeUser" class="btn btn-outline-dark">Keep my account</a>
                                <button type="submit" class="btn btn-danger">Close my account</button>
                            </div>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>