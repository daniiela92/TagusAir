@model TagusAir.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change password";
}

<section class="py-7">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">

                        <div class="text-center mb-5">
                            <span class="fas fa-key text-primary" style="font-size: 2.5rem;"></span>
                            <h2 class="fw-bold mt-3 mb-1">Change your password</h2>
                            <p class="text-900 mb-0">You will stay signed in after changing it.</p>
                        </div>

                        <form asp-action="ChangePassword" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="mb-4">
                                <label asp-for="OldPassword" class="form-label fw-medium"></label>
                                <input asp-for="OldPassword" type="password" class="form-control form-voyage-control" />
                                <span asp-validation-for="OldPassword" class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="NewPassword" class="form-label fw-medium"></label>
                                <input asp-for="NewPassword" type="password" class="form-control form-voyage-control" />
                                <span asp-validation-for="NewPassword" class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Confirm" class="form-label fw-medium"></label>
                                <input asp-for="Confirm" type="password" class="form-control form-voyage-control" />
                                <span asp-validation-for="Confirm" class="text-danger"></span>
                            </div>

                            <div class="d-grid mb-4">
                                <button type="submit" class="btn btn-secondary">Change password</button>
                            </div>

                            <div class="text-center">
                                <a class="text-900" asp-action="ChangeUser">Back to my profile</a>
                            </div>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}