@model TagusAir.Models.RegisterNewUserViewModel

@{
    ViewData["Title"] = "Create account";
}

<section class="py-7">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-9 col-lg-7">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">

                        <div class="text-center mb-5">
                            <span class="fas fa-user-plus text-primary" style="font-size: 2.5rem;"></span>
                            <h2 class="fw-bold mt-3 mb-1">Create your account</h2>
                            <p class="text-900 mb-0">It takes less than a minute</p>
                        </div>

                        <form asp-action="Register" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="row g-3">

                                <div class="col-sm-6">
                                    <label asp-for="FirstName" class="form-label fw-medium"></label>
                                    <input asp-for="FirstName" class="form-control form-voyage-control" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>

                                <div class="col-sm-6">
                                    <label asp-for="LastName" class="form-label fw-medium"></label>
                                    <input asp-for="LastName" class="form-control form-voyage-control" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="Username" class="form-label fw-medium">Email</label>
                                    <input asp-for="Username" class="form-control form-voyage-control" placeholder="you@@example.com" />
                                    <span asp-validation-for="Username" class="text-danger"></span>
                                </div>

                                <div class="col-sm-6">
                                    <label asp-for="Passport" class="form-label fw-medium"></label>
                                    <input asp-for="Passport" class="form-control form-voyage-control" />
                                    <span asp-validation-for="Passport" class="text-danger"></span>
                                </div>

                                <div class="col-sm-6">
                                    <label asp-for="PhoneNumber" class="form-label fw-medium"></label>
                                    <input asp-for="PhoneNumber" class="form-control form-voyage-control" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>

                                <div class="col-sm-6">
                                    <label asp-for="Password" class="form-label fw-medium"></label>
                                    <input asp-for="Password" type="password" class="form-control form-voyage-control" />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>

                                <div class="col-sm-6">
                                    <label asp-for="Confirm" class="form-label fw-medium"></label>
                                    <input asp-for="Confirm" type="password" class="form-control form-voyage-control" />
                                    <span asp-validation-for="Confirm" class="text-danger"></span>
                                </div>

                                <div class="col-12 d-grid mt-4">
                                    <button type="submit" class="btn btn-secondary">Create account</button>
                                </div>

                            </div>
                        </form>

                    </div>
                </div>

                <p class="text-center mt-4 text-900">
                    Already have an account?
                    <a class="fw-bold" asp-action="Login">Sign in</a>
                </p>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}