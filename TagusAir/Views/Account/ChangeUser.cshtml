@model TagusAir.Models.ChangeUserViewModel

@{
    ViewData["Title"] = "My profile";
}

<section class="py-6">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-9 col-lg-7">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5">

                        <h2 class="fw-bold mb-4">My profile</h2>

                        @if (ViewBag.UserMessage != null)
                        {
                            <div class="alert alert-success">@ViewBag.UserMessage</div>
                        }

                        <form asp-action="ChangeUser" method="post" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="text-center mb-4">
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl"
                                         class="rounded-circle mb-3"
                                         style="width: 120px; height: 120px; object-fit: cover;" />
                                }
                                else
                                {
                                    <span class="fas fa-user-circle text-800 d-block mb-3" style="font-size: 120px;"></span>
                                }

                                <div>
                                    <label asp-for="ImageFile" class="form-label fw-medium">Change photo</label>
                                    <input asp-for="ImageFile" type="file" class="form-control form-voyage-control" />
                                </div>
                            </div>

                            <div class="row g-3">

                                <div class="col-sm-6">
                                    <label asp-for="FirstName" class="form-label fw-medium"></label>
                                    <input asp-for="FirstName" class="form-control form-voyage-control" />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>

                                <div class="col-sm-6">
                                    <label asp-for="LastName" class="form-label fw-medium"></label>
                                    <input asp-for="LastName" class="form-control form-voyage-control" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>

                                <div class="col-sm-6">
                                    <label asp-for="Passport" class="form-label fw-medium"></label>
                                    <input asp-for="Passport" class="form-control form-voyage-control" />
                                    <span asp-validation-for="Passport" class="text-danger"></span>
                                </div>

                                <div class="col-sm-6">
                                    <label asp-for="PhoneNumber" class="form-label fw-medium"></label>
                                    <input asp-for="PhoneNumber" class="form-control form-voyage-control" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>

                                <div class="col-12 d-grid gap-2 d-sm-flex mt-4">
                                    <button type="submit" class="btn btn-secondary">Save changes</button>
                                    <a asp-action="ChangePassword" class="btn btn-voyage-outline">Change password</a>
                                </div>

                            </div>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}